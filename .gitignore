node_modules/
*.log

# dist/ is deliberately NOT ignored — it is committed, and CI verifies it
# matches packages/. Consumers read what is committed and published, not what a
# build could have produced.

.env
.env.*
# No npm dependencies here: the package.json only carries scripts, so the
# package-lock.json that `npm install` (DEV's scripts/setup.ps1) writes is
# empty. Drop this line if this repo ever gains dependencies — then the lock
# belongs in git.
package-lock.json
