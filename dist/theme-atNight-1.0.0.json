{
  "meta": {
    "id": "theme-atNight",
    "kind": "theme",
    "name": "atNight",
    "displayName": {
      "en": "atNight",
      "th": "atNight"
    },
    "version": "1.0.0",
    "targets": [
      "exe"
    ],
    "minAppVersion": "4.16.0",
    "source": "extracted from DraconDex-EXE electron/css/themes.css"
  },
  "payload": {
    "vars": {
      "--bg": "#04141c",
      "--surface": "#08202b",
      "--raised": "#0c2c3a",
      "--hover": "#113a4b",
      "--border": "#17495d",
      "--t1": "#e0f7ff",
      "--t2": "#8bbccb",
      "--t3": "#527481",
      "--accent": "#0ea5e9",
      "--accentH": "#22d3ee",
      "--danger": "#f87171",
      "--success": "#2dd4bf",
      "--on-accent": "var(--ink-dark)",
      "--on-button": "var(--ink-dark)"
    }
  }
}
