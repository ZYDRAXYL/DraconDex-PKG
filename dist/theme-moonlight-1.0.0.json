{
  "meta": {
    "id": "theme-moonlight",
    "kind": "theme",
    "name": "moonlight",
    "displayName": {
      "en": "moonlight",
      "th": "moonlight"
    },
    "version": "1.0.0",
    "targets": [
      "exe"
    ],
    "minAppVersion": "4.16.0",
    "source": "extracted from DraconDex-EXE electron/css/themes.css"
  },
  "payload": {
    "vars": {
      "--bg": "#101620",
      "--surface": "#182231",
      "--raised": "#223044",
      "--hover": "#2d3b52",
      "--border": "#334258",
      "--t1": "#edf4ff",
      "--t2": "#a6b3c7",
      "--t3": "#66758c",
      "--accent": "#7c9cff",
      "--accentH": "#9bb5ff",
      "--danger": "#f87171",
      "--success": "#34d399",
      "--on-accent": "var(--ink-dark)",
      "--on-button": "var(--ink-dark)"
    }
  }
}
